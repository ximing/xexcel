{
  "name": "@xexcel/view",
  "version": "1.0.0",
  "description": "Imperative Konva canvas for xexcel: virtualized grid, selection, fill handle, clipboard, keymap.",
  "license": "MIT",
  "author": "ximing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": [
    "spreadsheet",
    "excel",
    "canvas",
    "konva",
    "grid"
  ],
  "homepage": "https://ximing.github.io/xexcel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/xexcel.git",
    "directory": "packages/excel-view"
  },
  "bugs": {
    "url": "https://github.com/ximing/xexcel/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "konva": "^9.3.16"
  },
  "peerDependencies": {
    "@xexcel/core": "^1.0.0"
  },
  "devDependencies": {
    "@xexcel/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "~7.0",
    "vitest": "^2.1"
  }
}
