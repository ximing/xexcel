{
  "name": "@xexcel/react",
  "version": "1.0.0",
  "description": "React shell for xexcel: <ExcelEditor/> plus toolbar, formula bar, status bar, and UI primitives.",
  "license": "MIT",
  "author": "ximing",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "keywords": [
    "spreadsheet",
    "excel",
    "react",
    "grid",
    "xlsx"
  ],
  "homepage": "https://ximing.github.io/xexcel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/xexcel.git",
    "directory": "packages/excel-react"
  },
  "bugs": {
    "url": "https://github.com/ximing/xexcel/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && tailwindcss -i src/theme.css -o dist/styles.css --minify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.32.0"
  },
  "peerDependencies": {
    "@xexcel/core": "^1.0.0",
    "@xexcel/view": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@xexcel/core": "workspace:*",
    "@xexcel/view": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "~7.0",
    "vitest": "^4.1"
  }
}
