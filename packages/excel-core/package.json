{
  "name": "@xexcel/core",
  "version": "1.0.0",
  "description": "Headless spreadsheet engine: immutable workbook, transactions, plugins, formula evaluator, xlsx/CSV I/O. Zero DOM.",
  "license": "MIT",
  "author": "ximing",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": [
    "spreadsheet",
    "excel",
    "formula",
    "xlsx",
    "csv",
    "transaction",
    "headless",
    "typescript"
  ],
  "homepage": "https://ximing.github.io/xexcel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/xexcel.git",
    "directory": "packages/excel-core"
  },
  "bugs": {
    "url": "https://github.com/ximing/xexcel/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "numfmt": "^3.2.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~7.0",
    "vitest": "^2.1"
  }
}
